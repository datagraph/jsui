/*
 * jsui — the two control flows that reach a model: Run, and Dashboard.
 *
 * Revised 2026-10-19 against the implementation.  Earlier versions of this
 * picture also carried authentication, the pane chain and the path by which a
 * suggested query becomes a saved view; those are ordinary jsui and they
 * crowded out the part that is not.  What is left is the two flows in which
 * a language model is involved, drawn in enough detail to be checked against
 * the code.
 *
 *   R0–R8    RUN.  One prompt, a tool loop, a transcript.  The model asks;
 *            the browser decides and calls.  `ui/components/exploration-pane.js'
 *   D0–D14   DASHBOARD.  Authority granted once, then a reviewed panel set,
 *            runs the INTERFACE makes, and a page the model wrote running in
 *            a frame with no origin.  `ui/components/dashboard-pane.js'
 *
 * Both loops are the same loop: `lib/llm/tool-adapter.js' is the only thing
 * in this picture that speaks to both domains, and therefore the only place
 * where a datum from the LLM domain becomes an action in the service domain.
 * It is drawn once and entered twice.
 *
 * Two credentials govern the picture and are deliberately drawn apart:
 *
 *   BLUE   the service credential.  Issued by dydra, held by AuthStore, and
 *          presented on every request to a dydra resource.  The model never
 *          holds it: it emits tool_use blocks, which are requests *to the
 *          browser*, and the adapter decides whether to honour each one and
 *          then makes the call itself.
 *
 *   ORANGE the LLM credential.  Issued by the model provider, held in the
 *          exploration pane's settings, and presented only to the provider.
 *          It grants nothing in the dydra domain.
 *
 * Three edges are worth finding before the rest: R6e, where repository content
 * leaves the service domain for the provider; D9, where code the model wrote
 * is executed — in a frame with no origin, no credential and no network,
 * which is the whole reason it may be executed at all; and D17, where a
 * follow-up prompt is CLASSIFIED, because that is what decides whether it
 * costs the user another authorisation or nothing at all.
 *
 * The revise loop (D15–D21) is the second half of the dashboard flow and it
 * is drawn deliberately as a loop back into the same gates: a patch is not a
 * lighter kind of proposal with a lighter kind of review, it is the same
 * review entered at whichever point the change actually earns.  The classes
 * and what each costs:
 *
 *   presentational  markup, styles, captions, `uses'   no gate; applied in
 *                                                      the frame in place, so
 *                                                      scroll, tab, selection
 *                                                      and chart state survive
 *   computational   transforms, assertions             the bodies are checked
 *                                                      and the diff is shown
 *   data            a query, `accept', a parameter's   Gate 1 again, with a
 *                   domain, a new panel                per-panel diff; only new
 *                                                      and changed panels run
 *   authority       a repository, a budget, writing    Gate 0 — which a patch
 *                                                      cannot ask for
 *
 * The class is computed by comparing the normalised document before and
 * after, never read from the operation names: a patch described as a colour
 * change and performing a query change is a query change.
 *
 * D20 carries the one budget that is not the grant's.  The grant screens the
 * MODEL; the interaction budget bounds how often the finished PAGE may
 * re-run a panel by itself.  They are not the same question: the queries a
 * control re-runs are the ones already authorised at D18/Gate 1, so nothing
 * it does widens authority — what it spends is store time, and a meter
 * beside the page is what makes that visible.  It is renewable without a
 * gate, because a consent dialog in front of a query approved ten seconds
 * ago is the failure Gate 0 was designed to avoid.
 *
 *   dot -Tsvg prompt-pane-architecture.dot -o prompt-pane-architecture.svg
 *   dot -Tpdf prompt-pane-architecture.dot -o prompt-pane-architecture.pdf
 */
digraph prompt_pane {
  rankdir = TB;
  compound = true;
  newrank = true;
  ranksep = 1.15;
  nodesep = 0.6;
  /* Edge labels are placed as nodes; without room they stack on one another,
     which is how the previous revision of this picture became unreadable in
     the corner where the tool loop lives.  Labels here are kept to a line or
     two and the explanation is in the comment above and the legend below. */
  fontname = "Helvetica";
  node  [fontname = "Helvetica", fontsize = 10, shape = box, style = "rounded,filled",
         fillcolor = white, color = "#555555", margin = "0.12,0.07"];
  edge  [fontname = "Helvetica", fontsize = 9, color = "#555555", arrowsize = 0.7];

  /* ─────────────────────────── the browser ─────────────────────────── */
  subgraph cluster_browser {
    label = "browser — jsui   (holds both credentials, keeps them apart)";
    fontsize = 11;
    style = "rounded";
    color = "#999999";
    bgcolor = "#fbfbf9";

    subgraph cluster_prompt {
      label = "exploration pane  (ui/components/exploration-pane.js)\na peer of the view editors, in the same column";
      fontsize = 10; style = "rounded"; color = "#cccccc"; bgcolor = "#ffffff";
      authstore  [label = "AuthStore\nservice token + configuration,\nin memory only",
                  fillcolor = "#e8eef6", color = "#1f4e79"];
      llmcred    [label = "LLM CREDENTIAL\nprovider API key — a bearer token,\nnever sent to dydra",
                  shape = note, fillcolor = "#fbe5d0", color = "#a2672a", fontsize = 9];
      editor     [label = "Prompt · Run · Dashboard · Session", fillcolor = "#eef3ee"];
      llmlog     [label = "Transcript · left\nthe model: indicator, request digest, prose",
                  fillcolor = "#fdf8f2", color = "#a2672a"];
      mcplog     [label = "Transcript · right\nthe service: indicator, arguments, payload",
                  fillcolor = "#f4f8fc", color = "#1f4e79"];
      suggested  [label = "Suggested query\nsparqlFrom(fenced block) → Add as a view"];
    }

    adapter [label = "Tool-call adapter\nlib/llm/tool-adapter.js\n— POLICY ENFORCEMENT POINT —\nALLOW_TOOLS · the argument screen (lib/llm/grant.js)\ncarries one session handle",
             fillcolor = "#fff6e8", color = "#a2672a", penwidth = 2];
    provider [label = "Provider adapter\nlib/llm/providers.js — anthropic", shape = component,
              fillcolor = "#fff6e8", color = "#a2672a"];

    subgraph cluster_dash {
      label = "dashboard pane  (ui/components/dashboard-pane.js)\nauthority granted once, not a query confirmed at the end";
      fontsize = 10; style = "rounded"; color = "#cccccc"; bgcolor = "#ffffff";
      gate0   [label = "Gate 0 — authority\nrepositories · read-only · call ceiling\nrow + byte budget · lifetime\ncharged per call, revocable mid-run",
               shape = note, fillcolor = "#fdf8f2", color = "#a2672a"];
      gate1   [label = "Gate 1 — the panel set\nevery query, every transform's source,\nevery sentence and what it was written from\nTHE LAST POINT BEFORE ANYTHING RUNS",
               shape = note, fillcolor = "#fdf8f2", color = "#a2672a", penwidth = 2];
      runner  [label = "Panel runner\nlib/dashboard/runner.js\nthe INTERFACE's own runs, with digests",
               fillcolor = "#eef3ee"];
      dframe  [label = "Dashboard frame\nlib/dashboard/frame.js\nsandbox=\"allow-scripts\" · default-src 'none'\nopaque origin · no credential · no network\nTHE MODEL'S HTML AND SCRIPT RUN HERE",
               shape = component, fillcolor = "#f2efe6", color = "#8a5a1a", penwidth = 2];
      gate2   [label = "Gate 2 — disposition\nkeep the panels as views · save the page · discard",
               shape = note, fillcolor = "#fdf8f2", color = "#a2672a"];
      archive [label = "Archive\nlib/dashboard/archive.js\nreopen: no model, no gate\ngrouped by document, newest revision"];
      revise  [label = "Revise — the second prompt\nagainst the page, not the transcript",
               fillcolor = "#eef3ee"];
      patchcls[label = "The change, classified\nlib/app/patch.js — from the normalised\ndocument BEFORE and AFTER, never from\nthe operation names\npresentational · computational · data · authority",
               shape = note, fillcolor = "#fdf8f2", color = "#a2672a", penwidth = 2];
    }
  }

  /* ───────────────── service authority — the dydra credential ───────────────── */
  subgraph cluster_service_domain {
    label = "SERVICE AUTHORITY   — reachable only with the dydra credential —\nper-resource http:authorize-request, re-checked when the transaction is created";
    fontsize = 11; style = "rounded"; color = "#1f4e79"; penwidth = 2; bgcolor = "#f3f7fb";

    subgraph cluster_services {
      label = "endpoints";
      fontsize = 10; style = "rounded"; color = "#9fb8d0"; bgcolor = "#ffffff";
      mcpsvc   [label = "MCP endpoint\nPOST /{a}/{r}/mcp\ntools/list · resources/read · tools/call", shape = component];
      sparqlsvc[label = "SPARQL processor\nPOST /{a}/{r}/sparql", shape = component];
      viewsvc  [label = "View catalog\nGET/PUT/DELETE\n/system/accounts/{a}/repositories/{r}/views/{v}", shape = component];
      logsvc   [label = "Session + transcript store\nPOST /{a}/mcp/sparql", shape = component];
    }

    subgraph cluster_server {
      label = "spocq";
      fontsize = 10; style = "rounded"; color = "#9fb8d0"; bgcolor = "#ffffff";
      orchestrator [label = "orchestrator\nscore operations\ncatalog · profile · select · materialize"];
      persistence  [label = "persist-exploration\ncompare-and-set on version"];
    }

    subgraph cluster_stores {
      label = "stores";
      fontsize = 10; style = "rounded"; color = "#9fb8d0"; bgcolor = "#f6f6f6";
      quads   [label = "Repository quads\n{a}/{r}", shape = component];
      mcprepo [label = "<account>/mcp\nexploration graph (the service's)\ntranscript graph (the browser's)\nmcp:Dashboard per run\nrevisioned", shape = component];
      catalog [label = "View catalog storage", shape = component];
    }
  }

  /* ───────────────── llm authority — the provider credential ───────────────── */
  subgraph cluster_llm_domain {
    label = "LLM AUTHORITY   — reachable only with the provider credential —\nno dydra authority whatever";
    fontsize = 11; style = "rounded"; color = "#a2672a"; penwidth = 2; bgcolor = "#fdf6ee";
    llmsvc   [label = "Anthropic Messages API\nPOST /v1/messages\nx-api-key · anthropic-version\nanthropic-workspace-id", shape = component];
  }

  /* ═══════════════════════════ RUN ═══════════════════════════ */

  llmcred   -> adapter [label = "R0a  provider key", style = dashed, color = "#a2672a"];
  authstore -> adapter [label = "R0b  service token,\nfor every dydra call", style = dashed, color = "#1f4e79"];

  editor   -> adapter [label = "R1  Run  (⌘↵)"];

  // Call and reply on one arrow: four separate edges between these two put
  // four labels in one band and the band is what became unreadable.
  adapter  -> mcpsvc  [label = "R2  tools/list · resources/read ⟶\n⟵ ALLOW_TOOLS keeps one, the rest\nwithheld IN THE CLIENT;\nscore:// docs → system prompt",
                       color = "#1f4e79", dir = both];

  adapter  -> provider [label = "R3  request shape", minlen = 2];
  provider -> llmsvc   [label = "R4  POST messages + tools", color = "#a2672a"];
  llmsvc   -> adapter  [label = "R5  text + tool_use\n— a REQUEST, not an action —", color = "#a2672a"];
  // minlen 2 so this label does not land on the same rank as R2's and the
  // two do not share one strip of canvas.
  adapter  -> mcpsvc   [label = "R6  tools/call {op, body, session} ⟶\nby the BROWSER, under the USER's credential,\nafter the argument screen\n⟵ payload → tool_result\n(loop to R4 while stop_reason = tool_use)",
                        color = "#1f4e79", penwidth = 2, dir = both, minlen = 2];
  adapter  -> llmsvc   [label = "R6e  EGRESS: the payload leaves\nthe service domain",
                        color = "#a2672a", style = bold, constraint = false];

  mcpsvc   -> orchestrator [label = "R6a  resolve session, run it", color = "#1f4e79"];
  orchestrator -> quads    [label = "R6b  reads", color = "#1f4e79"];
  orchestrator -> persistence [label = "R6c  record the node", color = "#1f4e79"];
  persistence  -> mcprepo  [label = "R6d  exploration graph, version+1\n(re-posted whole: why R8 writes elsewhere)",
                            color = "#1f4e79", minlen = 2];

  adapter  -> llmlog    [label = "R7a  turn + trace"];
  adapter  -> mcplog    [label = "R7b  relayed call"];
  adapter  -> suggested [label = "R7c  final text → fenced query", minlen = 2];
  editor   -> logsvc    [label = "R8  transcript: prompt, primer, prose,\nevery payload — INSERT DATA into\n<exploration>/transcript",
                         color = "#1f4e79", style = bold];
  logsvc   -> mcprepo   [label = "R8a  beside the service's own record", color = "#1f4e79"];

  /* ═══════════════════════════ DASHBOARD ═══════════════════════════ */

  editor -> gate0 [label = "D0  Dashboard — its own pane,\nseeded with what was typed"];
  gate0  -> adapter [label = "D1  the grant\n(charged per call, revocable mid-run)",
                     color = "#a2672a", penwidth = 2];
  adapter -> gate1 [label = "D2  Phase 1 explores inside the grant —\nthe same loop, R3–R6, no further dialogs.\nThe last turn carries a ```dashboard block"];
  gate1 -> runner  [label = "D3  validated, and the user agreed.\nA transform that does not compile\nis refused HERE"];
  runner -> viewsvc   [label = "D4  optional: PUT the panels as temp views\n(swept on discard)",
                       style = dashed, color = "#1f4e79"];
  runner -> sparqlsvc [label = "D5  Phase 2: run each panel,\nunder the USER's token (D-I)", color = "#1f4e79", penwidth = 2];
  sparqlsvc -> quads  [taillabel = "D6  reads", labeldistance = 4.5, labelangle = 18,
                       color = "#1f4e79"];
  sparqlsvc -> runner [label = "D7  result + digest, per panel", color = "#1f4e79"];
  runner -> dframe    [label = "D8  Phase 3: mount the page,\nthen POST the results in.\nIt BINDS; it does not embed"];
  dframe -> dframe    [label = "D9  transforms (new Function) over the inputs;\nprose marked stale against the digests it\nwas written from; height reported back",
                       color = "#8a5a1a"];
  runner -> dframe    [label = "D10  Refresh = run again, post again:\nthe page holds no data",
                       style = dashed, constraint = false];
  dframe -> gate2     [label = "D11  the page, as the user sees it"];
  gate2  -> viewsvc   [label = "D12  Keep — PUT each panel as a view", style = dashed, color = "#1f4e79"];
  viewsvc -> catalog  [label = "D12a  stored", style = dashed, color = "#1f4e79"];
  gate2  -> logsvc    [label = "D13  record: mcp:Dashboard —\nthe page, every query and digest,\nevery transform's source, every\nassertion and what it was written from",
                       color = "#1f4e79", style = bold, minlen = 3];
  logsvc -> archive   [label = "D14  reopen: straight to D5. No model,\nno gate — the queries were authorised\nwhen they were written",
                       color = "#1f4e79", style = dashed];
  archive -> runner   [label = "D14a  live again, not a snapshot", style = dashed];

  /* ──────────────── DASHBOARD, continued: the page is revised ──────────────── */

  dframe -> revise  [label = "D15  ask for a change to the page\n— or D21: a region threw, and at most two\nautomatic repairs are attempted from here",
                     constraint = false];
  revise -> adapter [label = "D16  the document's SHAPE + the prompt.\nThe answer is a ```patch block",
                     constraint = false, minlen = 2];
  adapter -> patchcls [label = "D17  apply to a COPY, validate the RESULT,\nthen classify", penwidth = 2];
  // The label is a taillabel so that it hangs off the classifier rather than
  // landing in the gap between two adjacent nodes, which is where an ordinary
  // edge label goes and where there is no room for one.
  patchcls -> gate1   [taillabel = "D18  data —\nGate 1 again,\nper-panel diff",
                       labeldistance = 5.5, labelangle = -22,
                       color = "#a2672a", penwidth = 2, constraint = false];
  patchcls -> dframe  [label = "D19  presentational — applied to the DOM:\nno gate, no store, no reload",
                       color = "#8a5a1a", penwidth = 2, constraint = false, minlen = 2];
  dframe -> runner    [label = "D20  re-run ONE declared panel; the value is\nbound by a VALUES clause AFTER the\nauthorised query — never query text.\nCharged against the INTERACTION BUDGET,\nwhich bounds how often, not what",
                       color = "#1f4e79", style = bold, constraint = false];

  /* ─────────────────────────── what the boundaries mean ─────────────────────────── */
  subgraph cluster_legend {
    label = "reading the boundaries";
    fontsize = 11; style = "rounded"; color = "#999999"; bgcolor = "#ffffff";
    legend [shape = plaintext, style = "", fillcolor = "none", fontsize = 9, label =
      <<table border="0" cellborder="0" cellspacing="3" cellpadding="2">
       <tr><td align="left"><font color="#1f4e79"><b>━━ service authority</b></font></td>
           <td align="left">the dydra credential.  Authenticated per request<br align="left"/>
               (password / bearer / session / location), then authorized<br align="left"/>
               per resource, then again at transaction creation.</td></tr>
       <tr><td align="left"><font color="#a2672a"><b>━━ llm authority</b></font></td>
           <td align="left">the provider credential.  Reaches the Messages API<br align="left"/>
               and nothing else.</td></tr>
       <tr><td align="left"><b>the model's reach</b></td>
           <td align="left">= the user's authority ∩ ALLOW_TOOLS ∩ the grant.  The<br align="left"/>
               model has no credential and no route to the endpoint;<br align="left"/>
               it asks, and R6 is the browser answering on its behalf.</td></tr>
       <tr><td align="left"><b>the model's code</b></td>
           <td align="left">runs only in the dashboard frame: opaque origin, no<br align="left"/>
               credential, no network.  `script-src' there is permissive<br align="left"/>
               because there is nothing in the frame worth stealing and<br align="left"/>
               no way to send it anywhere.</td></tr>
       <tr><td align="left"><b>where it is weak</b></td>
           <td align="left">the allow-list of R2 is <i>client-side</i>, and the bearer<br align="left"/>
               token of R0b is permanent, unscoped and account-wide.<br align="left"/>
               Both are what OAuth scopes would move to the server —<br align="left"/>
               on the blue boundary only.  See<br align="left"/>
               mcp-oauth-authorization-plan.md.</td></tr>
       <tr><td align="left"><b>egress</b></td>
           <td align="left">R6e: whatever the model surveys is sent to the<br align="left"/>
               provider.  Repository read authority is not a bound on<br align="left"/>
               where the content then goes.</td></tr>
      </table>>];
  }

  /* keep the reading order top to bottom */
  { rank = same; quads; mcprepo; catalog; }
}
